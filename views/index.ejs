<%- include('partials/header') %>
<section class="hero">
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <span class="hero-badge">Since 2020</span>
    <h1 class="hero-title">SweetWorks</h1>
    <p class="hero-subtitle">Artisan pastries, custom cakes & dessert services crafted with passion</p>
    <div class="hero-buttons">
      <a href="/menu" class="btn btn-primary btn-lg">Explore Menu</a>
      <a href="/signature-treats" class="btn btn-outline btn-lg">Signature Treats</a>
      <a href="/services" class="btn btn-outline btn-lg">Our Services</a>
    </div>
    <div class="hero-scroll">
      <span>Scroll to explore</span>
      <div class="scroll-arrow"></div>
    </div>
  </div>
</section>



<section class="section section-alt fade-in">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Browse</span>
      <h2 class="section-title">Shop by Category</h2>
      <p class="section-desc">From classic cakes to artisan breads</p>
    </div>
    <div class="categories-grid staggered">
      <% categories.forEach((cat, i) => { %>
        <a href="/menu?category=<%= cat.slug %>" class="category-card" style="animation-delay: <%= 0.1 + i * 0.08 %>s">
          <div class="category-icon"><%= cat.name === 'Cakes' ? '🎂' : cat.name === 'Pastries' ? '🥐' : cat.name === 'Cookies' ? '🍪' : cat.name === 'Bread' ? '🍞' : '✨' %></div>
          <h3><%= cat.name %></h3>
          <p><%= cat.description %></p>
          <span class="category-link">Browse &rarr;</span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section fade-in">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Services</span>
      <h2 class="section-title">Beyond the Bakery</h2>
      <p class="section-desc">Custom creations and catering for every occasion</p>
    </div>
    <div class="services-preview">
      <% services.forEach((svc, i) => { %>
        <div class="service-preview-card" style="animation-delay: <%= 0.1 + i * 0.12 %>s">
          <div class="service-preview-icon">
            <% if (svc.type === 'buffet') { %>
              <%= svc.name.includes('Intimate') ? '🤝' : svc.name.includes('Fancy') ? '✨' : svc.name.includes('Magnificent') ? '👑' : '🍰' %>
            <% } else { %>
              🎨
            <% } %>
          </div>
          <h3><%= svc.name %></h3>
          <p><%= svc.description %></p>
          <div class="service-preview-footer">
            <% if (svc.type === 'buffet') { %>
              <span class="service-preview-price">Quotation</span>
            <% } else if (svc.price > 0) { %>
              <span class="service-preview-price">₱<%= svc.price.toFixed(2) %></span>
            <% } else { %>
              <span class="service-preview-price">Custom Quote</span>
            <% } %>
            <a href="/services" class="btn btn-sm btn-primary">Learn More</a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="cta-section fade-in">
  <div class="container">
    <div class="cta-content">
      <h2>Ready to order?</h2>
      <p>Browse our menu and place your order online for pickup or delivery.</p>
      <div class="cta-buttons">
        <a href="/order" class="btn btn-primary btn-lg">Order Online</a>
        <a href="/services" class="btn btn-outline btn-lg">Inquire About Services</a>
      </div>
      <div style="margin-top:1.5rem;opacity:0;animation:fadeSlideUp 0.6s ease-out 0.6s forwards">
        <a href="https://www.facebook.com/Sweetworks" target="_blank" rel="noopener" class="btn btn-outline" style="font-size:0.85rem;display:inline-flex;align-items:center;gap:0.5rem">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Follow on Facebook
        </a>
      </div>
    </div>
  </div>
</section>

<style>
/* Hero */
.hero {
  position: relative;
  min-height: 85vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 40%, #4A6B53 70%, var(--accent) 100%);
  overflow: hidden;
  padding: 6rem 0;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(255,255,255,0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(212,221,208,0.1) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 80%, rgba(61,90,69,0.3) 0%, transparent 50%);
  pointer-events: none;
}
.hero-content {
  position: relative;
  z-index: 1;
  animation: heroFadeIn 1s ease-out;
}
.hero-badge {
  display: inline-block;
  padding: 0.35rem 1rem;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--white);
  border: 1px solid rgba(255,255,255,0.3);
  margin-bottom: 1.5rem;
  opacity: 0;
  animation: fadeSlideUp 0.6s ease-out 0.2s forwards;
}
.hero-title {
  font-size: 4.5rem;
  color: var(--white);
  line-height: 1.1;
  margin-bottom: 1rem;
  text-shadow: 0 2px 20px rgba(0,0,0,0.15);
  opacity: 0;
  animation: fadeSlideUp 0.6s ease-out 0.3s forwards;
}
.hero-subtitle {
  font-size: 1.15rem;
  color: rgba(255,255,255,0.85);
  max-width: 520px;
  margin: 0 auto 2rem;
  line-height: 1.7;
  font-weight: 300;
  opacity: 0;
  animation: fadeSlideUp 0.6s ease-out 0.4s forwards;
}
.hero-buttons {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
  opacity: 0;
  animation: fadeSlideUp 0.6s ease-out 0.5s forwards;
}
.hero-scroll {
  position: absolute;
  bottom: 2rem;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  opacity: 0;
  animation: fadeSlideUp 0.6s ease-out 0.7s forwards;
  pointer-events: none;
}
.hero-scroll span {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: rgba(255,255,255,0.5);
}
.scroll-arrow {
  width: 1px;
  height: 30px;
  background: linear-gradient(to bottom, rgba(255,255,255,0.5), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}

/* Featured section */
.section-alt {
  background: var(--bg-alt);
}
.section-header {
  text-align: center;
  margin-bottom: 2.5rem;
}
.section-tag {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--primary);
  background: var(--accent-light);
  margin-bottom: 0.75rem;
}
.section-title {
  font-size: 2.5rem;
  color: var(--primary-dark);
  margin-bottom: 0.5rem;
}
.section-desc {
  color: var(--text-light);
  font-size: 1rem;
  max-width: 480px;
  margin: 0 auto;
}

/* Product cards refined */
.product-category {
  display: inline-block;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-light);
  margin-bottom: 0.4rem;
  font-family: 'Inter', sans-serif;
}

/* Category cards enhanced */
.category-card {
  background: var(--white);
  padding: 2rem;
  border-radius: 16px;
  text-align: center;
  border: 1px solid var(--border);
  transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
  display: block;
  position: relative;
  overflow: hidden;
}
.category-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: var(--primary);
  transform: scaleX(0);
  transition: transform 0.3s ease;
  transform-origin: left;
}
.category-card:hover::before {
  transform: scaleX(1);
}
.category-card:hover {
  transform: translateY(-4px) scale(1.02);
  box-shadow: 0 8px 24px rgba(61,90,69,0.15);
}
.category-icon {
  font-size: 2.5rem;
  margin-bottom: 0.75rem;
  display: block;
}
.category-link {
  display: inline-block;
  margin-top: 0.75rem;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--primary);
  transition: gap 0.2s;
}

/* Services preview */
.services-preview {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 1.5rem;
}
.service-preview-card {
  background: var(--white);
  border-radius: 16px;
  padding: 2rem;
  border: 1px solid var(--border);
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}
.service-preview-card:hover {
  box-shadow: 0 8px 24px rgba(61,90,69,0.12);
  transform: translateY(-3px);
}
.service-preview-icon {
  font-size: 2.5rem;
  margin-bottom: 1rem;
}
.service-preview-card h3 {
  font-size: 1.3rem;
  color: var(--primary-dark);
  margin-bottom: 0.5rem;
}
.service-preview-card p {
  color: var(--text-light);
  font-size: 0.9rem;
  line-height: 1.6;
  flex: 1;
  margin-bottom: 1rem;
}
.service-preview-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1rem;
  border-top: 1px solid var(--border);
}
.service-preview-price {
  font-weight: 700;
  color: var(--primary);
  font-size: 1.1rem;
}

/* CTA */
.cta-section {
  background: linear-gradient(135deg, var(--primary-dark), var(--primary));
  padding: 5rem 0;
  text-align: center;
}
.cta-content h2 {
  font-size: 2.8rem;
  color: var(--white);
  margin-bottom: 0.75rem;
}
.cta-content p {
  color: rgba(255,255,255,0.8);
  font-size: 1.1rem;
  margin-bottom: 2rem;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
.cta-buttons {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

/* Button variants */
.btn-lg {
  padding: 0.85rem 2rem;
  font-size: 1rem;
}
.btn-outline {
  background: transparent;
  color: var(--white);
  border: 2px solid rgba(255,255,255,0.5);
}
.btn-outline:hover {
  background: rgba(255,255,255,0.1);
  border-color: var(--white);
  color: var(--white);
}

/* Fade-in animations */
.fade-in {
  opacity: 0;
  animation: fadeIn 0.8s ease-out forwards;
}
.staggered > * {
  opacity: 0;
  animation: fadeSlideUp 0.6s ease-out forwards;
}
@keyframes heroFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes scrollPulse {
  0%, 100% { opacity: 1; transform: translateY(0); }
  50% { opacity: 0.3; transform: translateY(6px); }
}

/* Responsive */
@media (max-width: 768px) {
  .hero { min-height: 70vh; padding: 4rem 0; }
  .hero-title { font-size: 2.8rem; }
  .hero-subtitle { font-size: 1rem; }
  .section-title { font-size: 1.8rem; }
  .services-preview { grid-template-columns: 1fr; }
  .cta-content h2 { font-size: 2rem; }
  .hero-buttons { flex-direction: column; align-items: stretch; }
  .cta-buttons { flex-direction: column; align-items: stretch; }
  .cta-buttons .btn { text-align: center; }
  .hero-scroll { display: none; }
}
</style>

<%- include('partials/footer') %>