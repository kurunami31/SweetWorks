<%- include('partials/header') %>
<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Social</span>
      <h1 class="section-title">Follow Us on Facebook</h1>
      <p class="section-desc">Stay updated with our latest creations, promotions, and behind-the-scenes content</p>
    </div>
    <div class="social-feed">
      <div id="fb-root"></div>
      <script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v22.0"></script>
      <div class="fb-page" data-href="https://www.facebook.com/Sweetworks" data-tabs="timeline" data-width="" data-height="" data-small-header="false" data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="true">
        <blockquote cite="https://www.facebook.com/Sweetworks" class="fb-xfbml-parse-ignore">
          <a href="https://www.facebook.com/Sweetworks">SweetWorks</a>
        </blockquote>
      </div>
    </div>
  </div>
</section>
<style>
  .social-feed {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }
  .social-feed .fb-page {
    width: 100%;
    max-width: 700px;
  }
  .social-feed iframe {
    width: 100% !important;
  }
</style>
<%- include('partials/footer') %>