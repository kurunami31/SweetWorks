<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SweetWorks Admin</title>
  <link rel="icon" type="image/x-icon" href="/images/SweetWorks(logo).ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=2">
  <style>
    .admin-layout {
      display: flex;
      min-height: calc(100vh - 4rem);
      margin-top: 4rem;
    }
    .admin-sidebar {
      width: 200px;
      background: var(--primary-dark);
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.75rem;
      position: fixed;
      top: 4rem;
      left: 0;
      bottom: 0;
      z-index: 50;
    }
    .admin-sidebar-btn {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.7rem 0.75rem;
      border: none;
      border-radius: 8px;
      background: transparent;
      color: rgba(255,255,255,0.6);
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 500;
      transition: all 0.2s;
      text-decoration: none;
      font-family: 'Inter', sans-serif;
      position: relative;
    }
    .admin-sidebar-btn:hover { background: rgba(255,255,255,0.1); color: var(--white); }
    .admin-sidebar-btn.active { background: rgba(255,255,255,0.15); color: var(--white); }
    .admin-sidebar-btn .icon { font-size: 1.2rem; }
    .admin-sidebar-badge {
      margin-left: auto;
      background: var(--danger);
      color: white;
      font-size: 0.6rem;
      font-weight: 700;
      padding: 0.1rem 0.4rem;
      border-radius: 8px;
    }
    .admin-content {
      flex: 1;
      margin-left: 200px;
      padding: 2rem;
      overflow-y: auto;
    }
    @media (max-width: 768px) {
      .admin-sidebar {
        width: 100%;
        position: static;
        flex-direction: row;
        flex-wrap: wrap;
        padding: 0.5rem;
        gap: 0.25rem;
      }
      .admin-sidebar-btn { font-size: 0.75rem; padding: 0.5rem 0.6rem; }
      .admin-sidebar-btn .icon { font-size: 1rem; }
      .admin-content { margin-left: 0; padding: 1rem; }
      .admin-layout { flex-direction: column; margin-top: 0; }
    }
  </style>
</head>
<body>
  <nav class="navbar" style="position:fixed;top:0;left:0;right:0;z-index:100">
    <div class="container nav-container">
      <div class="nav-logo" style="cursor:default">
        <img src="/images/SweetWorks(logo).jpg" alt="SweetWorks" class="nav-logo-img">
        <span>SweetWorks</span>
      </div>
      <div style="display:flex;align-items:center;gap:0.5rem">
        <span style="font-size:0.8rem;color:var(--text-light)"><%= user?.username %></span>
        <a href="/logout" class="btn btn-sm" style="color:var(--danger)">Logout</a>
      </div>
    </div>
  </nav>
  <div class="admin-layout">
    <div class="admin-sidebar">
      <a href="/admin" class="admin-sidebar-btn <%= currentPage === 'dashboard' ? 'active' : '' %>">
        <span class="icon"><svg viewBox="0 0 24 24" width="1.2em" height="1.2em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span> Dashboard
      </a>
      <a href="/admin/products" class="admin-sidebar-btn <%= currentPage === 'products' ? 'active' : '' %>">
        <span class="icon"><svg viewBox="0 0 24 24" width="1.2em" height="1.2em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></span> Products
      </a>
      <a href="/admin/orders" class="admin-sidebar-btn <%= currentPage === 'orders' ? 'active' : '' %>">
        <span class="icon"><svg viewBox="0 0 24 24" width="1.2em" height="1.2em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></span> Orders
        <% if (typeof pendingOrders !== 'undefined' && pendingOrders > 0) { %><span class="admin-sidebar-badge"><%= pendingOrders %></span><% } %>
      </a>
      <a href="/admin/customers" class="admin-sidebar-btn <%= currentPage === 'customers' ? 'active' : '' %>">
        <span class="icon"><svg viewBox="0 0 24 24" width="1.2em" height="1.2em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span> Customers
      </a>
      <a href="/pos" class="admin-sidebar-btn <%= currentPage === 'pos' ? 'active' : '' %>">
        <span class="icon"><svg viewBox="0 0 24 24" width="1.2em" height="1.2em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></span> POS
      </a>
      <a href="/admin/service-orders" class="admin-sidebar-btn <%= currentPage === 'service-orders' ? 'active' : '' %>">
        <span class="icon"><svg viewBox="0 0 24 24" width="1.2em" height="1.2em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span> Services
        <% if (typeof pendingServiceOrders !== 'undefined' && pendingServiceOrders > 0) { %><span class="admin-sidebar-badge"><%= pendingServiceOrders %></span><% } %>
      </a>
    </div>
    <div class="admin-content">