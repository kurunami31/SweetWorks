<%- include('../partials/header') %>
<section class="section">
  <div class="container" style="max-width:400px">
    <h1 class="section-title">Admin Login</h1>
    <form method="POST" class="form-card">
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" required autofocus>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%">Login</button>
    </form>
    <p class="text-center" style="margin-top:1rem;font-size:0.9rem;color:var(--text-light)">
      Don't have an account? <a href="/register">Register here</a>
    </p>
  </div>
</section>
<style>
  .alert-error {
    background: #F8D7DA; color: #721C24; padding: 0.75rem 1rem;
    border-radius: 8px; margin-bottom: 1rem; font-size: 0.9rem;
  }
</style>
<%- include('../partials/footer') %>
