<%- include('../partials/header') %>
<section class="section">
  <div class="container">
    <div class="flex-between">
      <h1 class="section-title" style="margin:0">Service Orders</h1>
      <a href="/admin" class="btn">&larr; Dashboard</a>
    </div>
    <table class="table">
      <thead>
        <tr>
          <th>#</th>
          <th>Customer</th>
          <th>Service</th>
          <th>Email</th>
          <th>Status</th>
          <th>Date</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td><%= o.id %></td>
            <td><%= o.customer_name %></td>
            <td><%= o.service_name || 'N/A' %></td>
            <td><%= o.customer_email %></td>
            <td><span class="status-badge <%= o.status %>"><%= o.status %></span></td>
            <td><%= new Date(o.created_at).toLocaleDateString() %></td>
            <td class="action-cell"><a href="/admin/service-orders/<%= o.id %>" class="btn btn-sm">View</a></td>
          </tr>
        <% }) %>
        <% if (orders.length === 0) { %>
          <tr><td colspan="7" class="empty-state">No service orders yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>