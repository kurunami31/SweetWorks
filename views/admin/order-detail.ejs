<%- include('../partials/admin-header') %>
<section class="section">
  <div class="container">
    <a href="/admin/orders" class="btn" style="margin-bottom:1rem">← Back to Orders</a>
    <h1 class="section-title">Order #<%= order.id %></h1>
    <div class="order-detail-layout">
      <div class="form-card">
        <h3>Customer Info</h3>
        <p><strong>Name:</strong> <%= order.customer_name %></p>
        <p><strong>Email:</strong> <%= order.email %></p>
        <p><strong>Phone:</strong> <%= order.phone || '-' %></p>
        <p><strong>Address:</strong> <%= order.address || '-' %></p>
      </div>
      <div class="form-card">
        <h3>Order Info</h3>
        <p><strong>Type:</strong> <%- order.order_type === 'delivery' ? '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg> Delivery' : '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg> Pick Up' %></p>
        <p><strong>Status:</strong> <span class="status-badge <%= order.status %>"><%= order.status %></span></p>
        <p><strong>Date:</strong> <%= new Date(order.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) %></p>
        <% if (order.notes) { %>
          <p><strong>Schedule/Notes:</strong> <%= order.notes.replace(/\|/g, '<br>') %></p>
        <% } %>
        <% if (order.order_type === 'delivery') { %>
          <p style="color:var(--danger);font-size:0.85rem;margin-top:0.5rem">Transportation/Delivery Fee not included.</p>
        <% } %>
        <form method="POST" action="/admin/orders/<%= order.id %>/status" style="margin-top:1rem">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Update Status:</label>
          <select name="status">
            <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="preparing" <%= order.status === 'preparing' ? 'selected' : '' %>>Preparing</option>
            <option value="ready" <%= order.status === 'ready' ? 'selected' : '' %>>Ready</option>
            <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Completed</option>
            <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
          </select>
          <button type="submit" class="btn btn-sm btn-primary">Update</button>
        </form>
      </div>
    </div>
    <h2>Items</h2>
    <table class="table">
      <thead><tr><th>Product</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr></thead>
      <tbody>
        <% items.forEach(item => { %>
          <tr>
            <td><%= item.product_name %></td>
            <td><%= item.quantity %></td>
            <td>₱<%= item.price.toFixed(2) %></td>
            <td>₱<%= (item.price * item.quantity).toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot><tr><td colspan="3"><strong>Total</strong></td><td><strong>₱<%= order.total.toFixed(2) %></strong></td></tr></tfoot>
    </table>
  </div>
</section>
<%- include('../partials/admin-footer') %>
