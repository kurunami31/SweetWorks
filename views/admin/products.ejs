<%- include('../partials/header') %>
<section class="section">
  <div class="container">
    <div class="flex-between">
      <h1 class="section-title" style="margin-bottom:0">Products</h1>
      <button class="btn btn-primary" onclick="document.getElementById('add-form').classList.toggle('hidden')">+ Add Product</button>
    </div>

    <form id="add-form" method="POST" action="/admin/products" class="form-card hidden">
      <h3>Add Product</h3>
      <div class="form-row">
        <div class="form-group"><label>Name</label><input name="name" required></div>
        <div class="form-group"><label>Slug</label><input name="slug" required placeholder="product-slug"></div>
      </div>
      <div class="form-group"><label>Description</label><textarea name="description" rows="2"></textarea></div>
      <div class="form-row">
        <div class="form-group"><label>Price ($)</label><input type="number" step="0.01" name="price" required></div>
        <div class="form-group"><label>Category</label>
          <select name="category_id">
            <option value="">None</option>
            <% categories.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group"><label><input type="checkbox" name="available" checked> Available</label></div>
      </div>
      <button type="submit" class="btn btn-primary">Save Product</button>
    </form>

    <table class="table">
      <thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% products.forEach(p => { %>
          <tr>
            <td><%= p.name %></td>
            <td><%= p.category_name || '-' %></td>
            <td>₱<%= p.price.toFixed(2) %></td>
            <td><span class="status-badge <%= p.available ? 'completed' : 'pending' %>"><%= p.available ? 'Available' : 'Unavailable' %></span></td>
            <td class="action-cell">
              <button class="btn btn-sm" onclick="editProduct(<%= p.id %>)">Edit</button>
              <form method="POST" action="/admin/products/<%= p.id %>/toggle" style="display:inline">
                <button class="btn btn-sm"><%= p.available ? 'Disable' : 'Enable' %></button>
              </form>
              <form method="POST" action="/admin/products/<%= p.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this product?')">
                <button class="btn btn-sm btn-danger">Delete</button>
              </form>
            </td>
          </tr>
          <tr id="edit-<%= p.id %>" class="edit-row hidden">
            <td colspan="5">
              <form method="POST" action="/admin/products/<%= p.id %>/edit" class="form-card">
                <h4>Edit: <%= p.name %></h4>
                <div class="form-row">
                  <div class="form-group"><label>Name</label><input name="name" value="<%= p.name %>" required></div>
                  <div class="form-group"><label>Slug</label><input name="slug" value="<%= p.slug %>" required></div>
                </div>
                <div class="form-group"><label>Description</label><textarea name="description" rows="2"><%= p.description %></textarea></div>
                <div class="form-row">
                  <div class="form-group"><label>Price ($)</label><input type="number" step="0.01" name="price" value="<%= p.price %>" required></div>
                  <div class="form-group"><label>Category</label>
                    <select name="category_id">
                      <option value="">None</option>
                      <% categories.forEach(c => { %>
                        <option value="<%= c.id %>" <%= p.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="form-group"><label><input type="checkbox" name="available" <%= p.available ? 'checked' : '' %>> Available</label></div>
                </div>
                <button type="submit" class="btn btn-primary">Update</button>
                <button type="button" class="btn" onclick="document.getElementById('edit-<%= p.id %>').classList.add('hidden')">Cancel</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<script>
  function editProduct(id) {
    document.getElementById('edit-' + id).classList.remove('hidden');
  }
</script>
<%- include('../partials/footer') %>
