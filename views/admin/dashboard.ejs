<%- include('../partials/admin-header') %>
<section class="section">
  <div class="container">
    <h1 class="section-title">Admin Dashboard</h1>
    <div class="admin-nav-grid">
      <a href="/admin/products" class="admin-nav-card">
        <span class="admin-nav-icon"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></span>
        <span class="admin-nav-title">Products</span>
        <span class="admin-nav-count"><%= productCount %></span>
      </a>
      <a href="/admin/orders" class="admin-nav-card">
        <span class="admin-nav-icon"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></span>
        <span class="admin-nav-title">Orders</span>
        <span class="admin-nav-count"><%= orderCount %></span>
        <% if (pendingOrders > 0) { %><span class="admin-nav-badge"><%= pendingOrders %> pending</span><% } %>
      </a>
      <a href="/admin/customers" class="admin-nav-card">
        <span class="admin-nav-icon"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
        <span class="admin-nav-title">Customers</span>
        <span class="admin-nav-count"><%= customerCount %></span>
      </a>
      <a href="/admin/service-orders" class="admin-nav-card">
        <span class="admin-nav-icon"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>
        <span class="admin-nav-title">Services</span>
        <span class="admin-nav-count"><%= serviceOrderCount %></span>
        <% if (pendingServiceOrders > 0) { %><span class="admin-nav-badge"><%= pendingServiceOrders %> pending</span><% } %>
      </a>
    </div>
  </div>
</section>
<style>
.admin-nav-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.25rem;
  margin-top: 1.5rem;
}
.admin-nav-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 2rem 1.5rem;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 16px;
  text-decoration: none;
  transition: all 0.2s;
  position: relative;
}
.admin-nav-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(61,90,69,0.1);
  border-color: var(--accent);
}
.admin-nav-icon {
  font-size: 2.5rem;
  line-height: 1;
}
.admin-nav-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--primary-dark);
}
.admin-nav-count {
  font-size: 0.85rem;
  color: var(--text-light);
}
.admin-nav-badge {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  background: var(--danger);
  color: white;
  font-size: 0.65rem;
  font-weight: 700;
  padding: 0.2rem 0.5rem;
  border-radius: 10px;
  text-transform: uppercase;
}
</style>
<%- include('../partials/admin-footer') %>
