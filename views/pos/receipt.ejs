<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Receipt - Order #<%= order.id %></title>
  <style>
    body{font-family:monospace;font-size:12px;width:280px;margin:20px auto;padding:10px}
    .receipt{text-align:center}
    .receipt-header{margin-bottom:10px;border-bottom:1px dashed #000;padding-bottom:10px}
    .receipt-info{text-align:left;font-size:11px;margin-bottom:10px;padding-bottom:10px;border-bottom:1px dashed #000}
    .receipt-info p{margin:2px 0}
    .receipt-items{text-align:left;margin-bottom:10px}
    .receipt-line{display:flex;justify-content:space-between;padding:2px 0}
    .receipt-total{border-top:1px solid #000;padding-top:5px;text-align:right;font-size:14px}
    .receipt-footer{margin-top:10px;border-top:1px dashed #000;padding-top:10px}
    .btn{display:inline-block;padding:8px 16px;background:#333;color:#fff;text-decoration:none;border:none;cursor:pointer;margin-top:10px}
  </style>
</head>
<body>
<%
function to12h(t) {
  if (!t) return '';
  const parts = t.trim().split(':');
  if (parts.length < 2) return t.trim();
  let h = parseInt(parts[0]), m = parts[1];
  const ampm = h >= 12 ? 'PM' : 'AM';
  if (h === 0) h = 12;
  else if (h > 12) h = h - 12;
  return h + ':' + m + ' ' + ampm;
}
%>
  <div class="receipt">
    <div class="receipt-header">
      <h1>SweetWorks</h1>
      <p>Pastry Shop</p>
      <p>Order #<%= order.id %></p>
      <p><%= new Date(order.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) %></p>
      <% if (order.customer_name) { %><p>Customer: <%= order.customer_name %></p><% } %>
    </div>
    <% if (order.notes) { 
      const notes = order.notes;
      const deliveryDate = notes.match(/Delivery Date:\s*(.+?)(?:\||$)/i);
      const deliveryTime = notes.match(/Delivery Time:\s*(.+?)(?:\||$)/i);
      const pickupTime = notes.match(/Pickup Time:\s*(.+?)(?:\||$)/i);
    %>
    <div class="receipt-info">
      <p><strong><%= order.order_type === 'delivery' ? '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg> Delivery' : '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg> Pick Up' %></strong></p>
      <% if (order.order_type === 'delivery') { %>
        <% if (order.customer_address) { %><p><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> <%= order.customer_address %></p><% } %>
        <% if (deliveryDate) { %><p><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> <%= deliveryDate[1].trim() %></p><% } %>
        <% if (deliveryTime) { %><p><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> <%= to12h(deliveryTime[1]) %></p><% } %>
      <% } else { %>
        <% if (pickupTime) { %><p><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Pickup: <%= to12h(pickupTime[1]) %></p><% } %>
      <% } %>
    </div>
    <% } %>
    <div class="receipt-items">
      <% items.forEach(item => { %>
        <div class="receipt-line">
          <span><%= item.product_name %> × <%= item.quantity %></span>
          <span>₱<%= (item.price * item.quantity).toFixed(2) %></span>
        </div>
      <% }) %>
    </div>
    <div class="receipt-total">
      <strong>Total: ₱<%= order.total.toFixed(2) %></strong>
    </div>
    <div class="receipt-footer">
      <p>Thank you for visiting!</p>
    </div>
  </div>
  <div style="text-align:center">
    <button class="btn" onclick="window.print()">Print</button>
    <a href="/pos" class="btn">New Sale</a>
  </div>
  <script>window.addEventListener('load', () => window.print())</script>
</body>
</html>