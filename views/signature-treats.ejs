<%- include('partials/header') %>
<section class="section section-featured">
  <div class="section-featured-divider top"></div>
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Featured</span>
      <h2 class="section-title">Signature Treats</h2>
      <p class="section-desc">Our most beloved creations, baked fresh daily</p>
    </div>
    <div class="signatures-grid">
      <% featured.forEach((product, i) => { %>
        <div class="signature-card" style="animation-delay: <%= 0.1 + i * 0.1 %>s">
          <div class="signature-card-top">
            <span class="signature-number"><%= String(i + 1).padStart(2, '0') %></span>
            <span class="signature-category"><%= product.category_name || 'Bakery' %></span>
          </div>
          <h3 class="signature-name"><%= product.name %></h3>
          <p class="signature-desc"><%= product.description %></p>
          <div class="signature-footer">
            <span class="signature-price">₱<%= product.price.toFixed(2) %></span>
            <span class="signature-badge">Best Seller</span>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="text-center" style="margin-top:3rem">
      <a href="/menu" class="btn btn-primary btn-lg">View Full Menu &rarr;</a>
    </div>
  </div>
  <div class="section-featured-divider bottom"></div>
</section>

<style>
.signatures-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
  max-width: 900px;
  margin: 0 auto;
}
.signature-card {
  display: flex;
  flex-direction: column;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1.5rem;
  transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
  opacity: 0;
  animation: fadeSlideUp 0.5s ease-out forwards;
}
.signature-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(61,90,69,0.1);
  border-color: var(--accent);
}
.signature-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}
.signature-number {
  font-family: 'Inter', sans-serif;
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--accent);
  line-height: 1;
  letter-spacing: 1px;
}
.signature-category {
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-light);
  font-family: 'Inter', sans-serif;
  font-weight: 600;
}
.signature-name {
  font-size: 1.15rem;
  color: var(--primary-dark);
  margin-bottom: 0.4rem;
  font-weight: 700;
  line-height: 1.3;
}
.signature-desc {
  color: var(--text-light);
  font-size: 0.85rem;
  line-height: 1.6;
  margin-bottom: 1rem;
  flex: 1;
}
.signature-footer {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border);
}
.signature-price {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--primary);
}
.signature-badge {
  padding: 0.2rem 0.6rem;
  border-radius: 6px;
  font-size: 0.6rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--white);
  background: var(--primary);
}
@media (max-width: 768px) {
  .signatures-grid {
    grid-template-columns: 1fr;
    max-width: 100%;
  }
}
@media (max-width: 480px) {
  .signature-card { padding: 1.25rem; }
  .signature-name { font-size: 1rem; }
}
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>
<%- include('partials/footer') %>