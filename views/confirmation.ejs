<%- include('partials/header') %>
<section class="section">
  <div class="container confirmation">
    <div class="confirmation-icon"><svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
    <h1>Order Confirmed!</h1>
    <p>Thank you, <strong><%= order.customer_name %></strong>! Your order #<%= order.id %> has been placed.</p>
    <div class="order-summary">
      <h2>Order #<%= order.id %></h2>
      <p>Status: <span class="status-badge pending"><%= order.status %></span></p>
      <p>Type: <strong><%- order.order_type === 'delivery' ? '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg> Delivery' : '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg> Pick Up' %></strong></p>
      <% if (order.notes) { %>
        <p style="margin-top:0.5rem"><strong>Schedule:</strong> <%= order.notes.split(' | ')[0] %></p>
      <% } %>
      <% if (order.order_type === 'delivery') { %>
        <p style="color:var(--danger);font-size:0.85rem;margin-top:0.5rem">Transportation/Delivery Fee is not included in the prices of products/services availed.</p>
      <% } %>
      <table class="table">
        <thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr></thead>
        <tbody>
          <% items.forEach(item => { %>
            <tr>
              <td><%= item.product_name %></td>
              <td><%= item.quantity %></td>
              <td>₱<%= item.price.toFixed(2) %></td>
              <td>₱<%= (item.price * item.quantity).toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot><tr><td colspan="3"><strong>Total</strong></td><td><strong>₱<%= order.total.toFixed(2) %></strong></td></tr></tfoot>
      </table>
    </div>
    <p>A confirmation email will be sent to <strong><%= order.customer_email %></strong>.</p>
    <a href="/menu" class="btn btn-primary">Continue Shopping</a>
  </div>
</section>
<%- include('partials/footer') %>
