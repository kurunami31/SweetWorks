<%- include('partials/header') %>
<section class="section">
  <div class="container">
    <h1 class="section-title">Our Services</h1>
    <% if (submitted) { %>
      <div class="form-card" style="background:#D4EDDA;border-color:#155724;text-align:center;padding:2rem">
        <h2 style="color:#155724">Order Submitted!</h2>
        <p style="color:#155724">Thank you! We will review your request and get back to you soon.</p>
      </div>
    <% } %>
    <div class="services-grid">
      <% services.forEach(service => { %>
        <% if (service.type === 'buffet') { %>
          <div class="service-card" id="service-<%= service.id %>">
            <div class="service-card-header">
              <span class="service-type-badge">🍰 Sweet Buffet</span>
              <h2><%= service.name %></h2>
              <p class="service-header-desc"><%= service.description %></p>
            </div>
            <div class="service-card-body">
              <p class="service-price">Quotation-based</p>
              <div class="buffet-tiers">
                <div class="buffet-tier" onclick="selectBuffetTier(this, 'intimate')">
                  <span class="buffet-tier-icon">🤝</span>
                  <div class="buffet-tier-info">
                    <strong>Intimate</strong>
                    <span>10–20 guests</span>
                    <p>Assorted cakes, pastries, cookies & selected beverages</p>
                  </div>
                </div>
                <div class="buffet-tier" onclick="selectBuffetTier(this, 'fancy')">
                  <span class="buffet-tier-icon">✨</span>
                  <div class="buffet-tier-info">
                    <strong>Fancy</strong>
                    <span>20–50 guests</span>
                    <p>Premium cakes, artisan pastries, chocolate fountain & beverage bar</p>
                  </div>
                </div>
                <div class="buffet-tier" onclick="selectBuffetTier(this, 'magnificent')">
                  <span class="buffet-tier-icon">👑</span>
                  <div class="buffet-tier-info">
                    <strong>Magnificent</strong>
                    <span>50+ guests</span>
                    <p>Multi-tier cakes, French patisserie, dessert stations & event coordination</p>
                  </div>
                </div>
              </div>
              <button class="btn btn-primary" onclick="showOrderForm(<%= service.id %>)" style="width:100%;margin-top:1rem">Get a Quote</button>
            </div>
          </div>
        <% } else { %>
          <div class="service-card" id="service-<%= service.id %>">
            <div class="service-card-header">
              <span class="service-type-badge">🎨 Custom Cake</span>
              <h2><%= service.name %></h2>
              <p class="service-header-desc"><%= service.description %></p>
            </div>
            <div class="service-card-body">
              <p class="service-price">Price depends on design</p>
              <button class="btn btn-primary" onclick="showOrderForm(<%= service.id %>)" style="width:100%">Order Now</button>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>
  </div>
</section>

<div id="service-order-modal" class="modal hidden">
  <div class="modal-content">
    <button class="modal-close" onclick="closeOrderForm()">&times;</button>
    <h2 id="modal-service-name" style="margin-bottom:1rem">Order Service</h2>
    <form method="POST" action="/services" enctype="multipart/form-data" id="service-order-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="service_id" id="form-service-id">
      <input type="hidden" name="buffet_tier" id="form-buffet-tier" value="">
      <div id="buffet-tier-selector" style="display:none;margin-bottom:1rem">
        <label style="font-weight:600;display:block;margin-bottom:0.5rem">Select Buffet Tier</label>
        <div class="tier-options">
          <label class="tier-option" onclick="document.getElementById('form-buffet-tier').value='intimate'">
            <input type="radio" name="buffet_tier_radio" value="intimate" onchange="document.getElementById('form-buffet-tier').value=this.value">
            <span class="tier-option-content">
              <strong>🤝 Intimate</strong>
              <small>10–20 guests</small>
            </span>
          </label>
          <label class="tier-option" onclick="document.getElementById('form-buffet-tier').value='fancy'">
            <input type="radio" name="buffet_tier_radio" value="fancy" onchange="document.getElementById('form-buffet-tier').value=this.value">
            <span class="tier-option-content">
              <strong>✨ Fancy</strong>
              <small>20–50 guests</small>
            </span>
          </label>
          <label class="tier-option" onclick="document.getElementById('form-buffet-tier').value='magnificent'">
            <input type="radio" name="buffet_tier_radio" value="magnificent" onchange="document.getElementById('form-buffet-tier').value=this.value">
            <span class="tier-option-content">
              <strong>👑 Magnificent</strong>
              <small>50+ guests</small>
            </span>
          </label>
        </div>
      </div>
      <div id="quotation-notice" style="display:none;background:var(--accent-light);padding:0.75rem;border-radius:8px;margin-bottom:1rem;font-size:0.85rem;color:var(--primary-dark)">
        This service is quotation-based. The final price will be provided by our team after reviewing your requirements.
      </div>
      <div class="form-group">
        <label>Your Name *</label>
        <input type="text" name="customer_name" required>
      </div>
      <div class="form-group">
        <label>Email *</label>
        <input type="email" name="customer_email" required>
      </div>
      <div class="form-group">
        <label>Phone</label>
        <input type="tel" name="customer_phone">
      </div>
      <div class="form-group">
        <label>Details / Requests *</label>
        <textarea name="details" rows="4" required placeholder="Describe what you need — flavor, size, theme, occasion, number of guests, etc."></textarea>
      </div>
      <div class="form-group" id="inspo-upload">
        <label>Inspiration Photo</label>
        <input type="file" name="inspo_image" accept="image/*">
        <p style="font-size:0.8rem;color:var(--text-light);margin-top:0.25rem">Upload a photo of your dream cake design (max 5MB)</p>
      </div>
      <div class="modal-actions">
        <button type="submit" class="btn btn-primary" style="flex:1">Submit Order</button>
        <button type="button" class="btn" onclick="closeOrderForm()">Cancel</button>
      </div>
    </form>
  </div>
</div>

<style>
.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
  gap: 1.5rem;
  margin-top: 1rem;
}
.service-card {
  background: var(--white);
  border-radius: 12px;
  border: 1px solid var(--border);
  overflow: hidden;
  transition: box-shadow 0.2s;
}
.service-card:hover {
  box-shadow: var(--shadow);
}
.service-card-header {
  background: var(--primary);
  color: var(--white);
  padding: 1.5rem;
  position: relative;
}
.service-card-header h2 {
  font-size: 1.3rem;
  margin: 0;
}
.service-header-desc {
  font-size: 0.85rem;
  opacity: 0.85;
  margin-top: 0.5rem;
  line-height: 1.5;
}
.service-type-badge {
  display: inline-block;
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: rgba(255,255,255,0.2);
  margin-bottom: 0.5rem;
}
.service-card-body {
  padding: 1.5rem;
}
.service-price {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 1rem;
}
.buffet-tiers {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.buffet-tier {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.75rem;
  border-radius: 10px;
  border: 1.5px solid var(--border);
  cursor: pointer;
  transition: all 0.2s;
}
.buffet-tier:hover {
  border-color: var(--primary);
  background: var(--bg);
}
.buffet-tier.selected {
  border-color: var(--primary);
  background: var(--accent-light);
}
.buffet-tier-icon {
  font-size: 1.5rem;
  line-height: 1;
  margin-top: 0.1rem;
}
.buffet-tier-info strong {
  display: block;
  font-size: 0.95rem;
  color: var(--primary-dark);
}
.buffet-tier-info span {
  display: block;
  font-size: 0.8rem;
  color: var(--primary);
  font-weight: 600;
  margin-top: 0.1rem;
}
.buffet-tier-info p {
  font-size: 0.82rem;
  color: var(--text-light);
  margin: 0.2rem 0 0;
  line-height: 1.4;
}
.tier-options {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.tier-option {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 0.75rem;
  border-radius: 8px;
  border: 1.5px solid var(--border);
  cursor: pointer;
  transition: all 0.2s;
}
.tier-option:has(input:checked) {
  border-color: var(--primary);
  background: var(--accent-light);
}
.tier-option input {
  accent-color: var(--primary);
}
.tier-option-content {
  display: flex;
  flex-direction: column;
}
.tier-option-content strong {
  font-size: 0.9rem;
  color: var(--primary-dark);
}
.tier-option-content small {
  font-size: 0.78rem;
  color: var(--text-light);
}
@media (max-width: 768px) {
  .services-grid { grid-template-columns: 1fr; }
}
</style>

<script>
let selectedBuffetTier = '';

function selectBuffetTier(el, tier) {
  document.querySelectorAll('.buffet-tier').forEach(t => t.classList.remove('selected'));
  el.classList.add('selected');
  selectedBuffetTier = tier;
}

function showOrderForm(serviceId) {
  const isBuffet = document.querySelector('#service-' + serviceId + ' .service-type-badge').textContent.includes('Sweet Buffet');
  document.getElementById('form-service-id').value = serviceId;
  document.getElementById('buffet-tier-selector').style.display = isBuffet ? 'block' : 'none';
  document.getElementById('quotation-notice').style.display = isBuffet ? 'block' : 'none';
  document.getElementById('inspo-upload').style.display = isBuffet ? 'none' : 'block';
  document.getElementById('modal-service-name').textContent = isBuffet ? 'Order: Sweet Buffet' : 'Order: Customized Cake';
  document.getElementById('service-order-modal').classList.remove('hidden');
}

function closeOrderForm() {
  document.getElementById('service-order-modal').classList.add('hidden');
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeOrderForm();
});
</script>
<%- include('partials/footer') %>